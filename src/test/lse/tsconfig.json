{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": [
            "@levimc-lse/types",
            "@types/node" // Why?
        ],
        "outDir": "dist/",
        "noEmit": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
    },
    "include": [
        "src/**.ts",
        "scripts/**.ts"
    ]
}